<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- gRPC Context -->
    <suppress>
        <notes><![CDATA[False positive / HTTP2 Rapid Reset not applicable to grpc-context]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.grpc/grpc-context@.*$</packageUrl>
        <cpe regex="true">.*</cpe>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

    <!-- Jackson -->
    <suppress>
        <notes><![CDATA[Suppress Jackson CVEs]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson.*$</packageUrl>
        <cpe regex="true">.*</cpe>
        <vulnerabilityName regex="true">.*</vulnerabilityName>
    </suppress>

