# ===============================================
# PostgreSQL Configuration
# ===============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/mydatabase
SPRING_DATASOURCE_USERNAME=myuser
SPRING_DATASOURCE_PASSWORD=your_postgres_password
POSTGRES_DB=mydatabase
POSTGRES_USER=myuser
POSTGRES_PASSWORD=your_postgres_password

# ===============================================
# RabbitMQ Configuration
# ===============================================
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=user
SPRING_RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# ===============================================
# Email (SMTP / IMAP) Configuration
# ===============================================
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@example.com
SPRING_MAIL_PASSWORD=your_email_app_password
SPRING_MAIL_IMAP_HOST=imap.gmail.com
SPRING_MAIL_IMAP_PORT=993

# ===============================================
# AI Providers API Keys
# ===============================================
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
GITHUB_TOKEN=your_github_token
MISTRAL_API_KEY=your_mistral_api_key

# ===============================================
# Google OAuth2 Credentials
# ===============================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8080/iam/oauth2/google/callback
GOOGLE_SYSTEM_REDIRECT_URI=http://localhost:8080/auth/oauth2/google/callback

# ===============================================
# Facebook Messenger Webhook
# ===============================================
FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token

# ===============================================
# Initial Data Seeding
# ===============================================
DEFAULT_USER_PASSWORD=your_default_seed_password

# ===============================================
# Server Port
# ===============================================
PORT=8080
