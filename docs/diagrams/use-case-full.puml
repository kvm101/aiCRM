@startuml aiCRM_UseCase_Full
!theme plain
title aiCRM — UML Use Case Diagram (повна система)

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FEFECE
  BorderColor #333333
  FontSize 11
}
skinparam actor {
  FontSize 12
}
skinparam package {
  FontSize 12
  FontStyle bold
}

actor "Менеджер" as M
actor "Адміністратор" as A
actor "AI Асистент\n(LLM)" as AI
actor "Клієнт" as C
actor "MCP-клієнт" as MCP

rectangle "Система aiCRM" {

  package "IAM — Доступ" #E8F4FD {
    usecase "Авторизація\n(login / OAuth2)" as UC_Auth
    usecase "Управління доступом\n(користувачі, ролі)" as UC_Access
    usecase "Управління організацією\nта проєктами" as UC_Org
  }

  package "Sales — CRM" #F0FDE8 {
    usecase "Управління клієнтами" as UC_Clients
    usecase "Створення угоди" as UC_Deal
    usecase "Ведення угоди\n(статус, нотатки, події)" as UC_DealMgmt
    usecase "Управління задачами\n(Kanban)" as UC_Tasks
    usecase "Перегляд дашборду" as UC_Dash
    usecase "Аналітика\n(воронка, цілі)" as UC_Analytics
  }

  package "Communications" #FDF4E8 {
    usecase "Спілкування з клієнтом\n(чат, Messenger)" as UC_Chat
    usecase "Робота з email\n(вхідні / вихідні)" as UC_Email
    usecase "Перегляд сповіщень" as UC_Notify
    usecase "Обробка вхідного\nповідомлення" as UC_Inbound
    usecase "Автоматичне створення\nліда та угоди" as UC_Lead
  }

  package "AI & Knowledge" #EDE8FD {
    usecase "Взаємодія з AI-асистентом" as UC_AIChat
    usecase "Автоматизація рутини" as UC_Auto
    usecase "Пошук по базі знань (RAG)" as UC_RAG
    usecase "Налаштування RAG\n(pgvector, embeddings)" as UC_RAGCfg
  }

  package "Attachments" #F5F5F5 {
    usecase "Завантаження та керування\nфайлами" as UC_Files
    usecase "Індексація документів\nдля RAG" as UC_Index
  }

  package "Reporting" #FFF0F0 {
    usecase "Формування звіту" as UC_Report
    usecase "Завантаження звіту (CSV)" as UC_Download
  }

  package "MCP" #E8FDF5 {
    usecase "Доступ до CRM-інструментів\nчерез MCP" as UC_MCP
  }
}

' Менеджер
M --> UC_Auth
M --> UC_Clients
M --> UC_Deal
M --> UC_DealMgmt
M --> UC_Tasks
M --> UC_Dash
M --> UC_Analytics
M --> UC_Chat
M --> UC_Email
M --> UC_Notify
M --> UC_AIChat
M --> UC_Files
M --> UC_Report
M --> UC_Download

' Адміністратор
A --> UC_Auth
A --> UC_Access
A --> UC_Org
A --> UC_RAGCfg

' AI Асистент
AI --> UC_Auto
AI --> UC_RAG

' Клієнт
C --> UC_Inbound

' MCP-клієнт
MCP --> UC_MCP

' Зв'язки між прецедентами
M ..> UC_AIChat : <<ініціює>>
UC_AIChat ..> UC_Auto : <<include>>
UC_AIChat ..> UC_RAG : <<include>>
UC_Report ..> UC_Download : <<include>>
UC_Files ..> UC_Index : <<include>>
UC_Index ..> UC_RAG : <<extend>>
UC_Inbound ..> UC_Lead : <<include>>
UC_Lead ..> UC_Deal : <<extend>>
UC_Inbound ..> UC_Chat : <<extend>>
UC_MCP ..> UC_Auto : <<include>>

@enduml
