%% aiCRM — UML Use Case (Mermaid)
%% Актори: (( )) — чоловічки, прецеденти: ([ ]) — овали

flowchart LR
    M((Менеджер))
    A((Адміністратор))
    AI((AI Асистент<br/>LLM))
    C((Клієнт))
    MCP((MCP-клієнт))

    subgraph aiCRM["Система aiCRM"]

        subgraph IAM["IAM — Доступ"]
            UC_Auth(["Авторизація<br/>login / OAuth2"])
            UC_Access(["Управління доступом<br/>користувачі, ролі"])
            UC_Org(["Управління організацією<br/>та проєктами"])
        end

        subgraph Sales["Sales — CRM"]
            UC_Clients(["Управління клієнтами"])
            UC_Deal(["Створення угоди"])
            UC_DealMgmt(["Ведення угоди<br/>статус, нотатки, події"])
            UC_Tasks(["Управління задачами<br/>Kanban"])
            UC_Dash(["Перегляд дашборду"])
            UC_Analytics(["Аналітика<br/>воронка, цілі"])
        end

        subgraph Comms["Communications"]
            UC_Chat(["Спілкування з клієнтом<br/>чат, Messenger"])
            UC_Email(["Робота з email<br/>вхідні / вихідні"])
            UC_Notify(["Перегляд сповіщень"])
            UC_Inbound(["Обробка вхідного<br/>повідомлення"])
            UC_Lead(["Автоматичне створення<br/>ліда та угоди"])
        end

        subgraph AI_K["AI & Knowledge"]
            UC_AIChat(["Взаємодія з<br/>AI-асистентом"])
            UC_Auto(["Автоматизація рутини"])
            UC_RAG(["Пошук по базі знань<br/>RAG"])
            UC_RAGCfg(["Налаштування RAG<br/>pgvector, embeddings"])
        end

        subgraph Attach["Attachments"]
            UC_Files(["Завантаження та<br/>керування файлами"])
            UC_Index(["Індексація документів<br/>для RAG"])
        end

        subgraph Report["Reporting"]
            UC_Report(["Формування звіту"])
            UC_Download(["Завантаження звіту<br/>CSV"])
        end

        subgraph MCP_P["MCP"]
            UC_MCP(["Доступ до CRM-інструментів<br/>через MCP"])
        end
    end

    %% Менеджер
    M --> UC_Auth & UC_Clients & UC_Deal & UC_DealMgmt & UC_Tasks
    M --> UC_Dash & UC_Analytics & UC_Chat & UC_Email & UC_Notify
    M --> UC_AIChat & UC_Files & UC_Report & UC_Download

    %% Адміністратор
    A --> UC_Auth & UC_Access & UC_Org & UC_RAGCfg

    %% AI Асистент
    AI --> UC_Auto & UC_RAG

    %% Клієнт
    C --> UC_Inbound

    %% MCP-клієнт
    MCP --> UC_MCP

    %% include / extend
    M -.->|ініціює| UC_AIChat
    UC_AIChat -.->|include| UC_Auto
    UC_AIChat -.->|include| UC_RAG
    UC_Report -.->|include| UC_Download
    UC_Files -.->|include| UC_Index
    UC_Index -.->|extend| UC_RAG
    UC_Inbound -.->|include| UC_Lead
    UC_Lead -.->|extend| UC_Deal
    UC_Inbound -.->|extend| UC_Chat
    UC_MCP -.->|include| UC_Auto
