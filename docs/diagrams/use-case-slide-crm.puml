@startuml aiCRM_UseCase_Slide_CRM
!theme plain
title aiCRM — Use Case (Слайд 1: CRM та комунікації)

left to right direction
skinparam actorStyle awesome

actor "Менеджер" as M
actor "Адміністратор" as A
actor "Клієнт" as C

rectangle "Система aiCRM" {
  usecase "CRM:\nклієнти · угоди · Kanban" as UC1
  usecase "Комунікації:\nчат · email · сповіщення" as UC2
  usecase "Аналітика та дашборд" as UC3
  usecase "Звіти" as UC4
  usecase "Доступ та проєкти" as UC5
  usecase "Вхідне повідомлення → лід" as UC6
}

M --> UC1
M --> UC2
M --> UC3
M --> UC4
A --> UC5
C --> UC6
UC6 ..> UC1 : <<extend>>

@enduml
