@startuml aiCRM_UseCase_Slide_AI
!theme plain
title aiCRM — Use Case (Слайд 2: AI та знання)

left to right direction
skinparam actorStyle awesome

actor "Менеджер" as M
actor "AI Асистент\n(LLM)" as AI
actor "MCP-клієнт" as MCP
actor "Адміністратор" as A

rectangle "Система aiCRM" {
  usecase "AI-чат" as UC1
  usecase "Автоматизація рутини" as UC2
  usecase "RAG-пошук" as UC3
  usecase "Файли та індексація" as UC4
  usecase "Налаштування RAG" as UC5
  usecase "MCP-інструменти" as UC6
}

M --> UC1
M --> UC4
AI --> UC2
AI --> UC3
MCP --> UC6
A --> UC5

UC1 ..> UC2 : <<include>>
UC1 ..> UC3 : <<include>>
UC4 ..> UC3 : <<extend>>
UC6 ..> UC2 : <<include>>

@enduml
