%% aiCRM — UML Deployment Diagram (Mermaid)
%% Повна версія + компактна для слайду (розділені ---)

flowchart TB
    subgraph Users["«device» Робочі станції"]
        Browser["🌐 Браузер оператора"]
        MCP["🔌 MCP-клієнт<br/>Cursor · Claude Desktop"]
    end

    subgraph External["«node» Зовнішні сервіси (Cloud)"]
        Gemini["☁️ Gemini API<br/>LLM + Embeddings"]
        Google["🔐 Google OAuth2"]
        Facebook["💬 Facebook Graph API"]
        Gmail["📧 Gmail SMTP / IMAP"]
    end

    subgraph ClientChannel["«device» Канал клієнта"]
        Messenger["📱 Messenger / Email клієнт"]
    end

    subgraph AppServer["«node» Application Server (localhost / dev)"]

        subgraph FE_Env["«execution environment» Node.js 18+"]
            NextJS["📦 Next.js Frontend<br/>:3000<br/>React 19 · App Router"]
        end

        subgraph BE_Env["«execution environment» JVM 21"]
            SpringBoot["📦 Spring Boot Backend<br/>:8080<br/>Modular Monolith JAR<br/>Virtual Threads"]
            LocalFS["💾 Local File System<br/>~/aicrm-uploads/<br/>~/aicrm-reports/"]
        end
    end

    subgraph DockerHost["«node» Docker Host (compose.yaml)"]

        subgraph PG_Env["«execution environment» PostgreSQL 16"]
            Postgres[("🗄️ PostgreSQL + pgvector<br/>:5432<br/>mydatabase")]
        end

        subgraph RMQ_Env["«execution environment» RabbitMQ 3"]
            RabbitMQ["📨 RabbitMQ<br/>:5672 AMQP<br/>:15672 Management"]
        end
    end

    %% Користувачі → Frontend
    Browser -->|"HTTPS"| NextJS
    Browser -->|"WebSocket ws://:8080/ws/*"| SpringBoot

    %% Frontend → Backend
    NextJS -->|"REST HTTP :8080<br/>X-Project-Id, X-User-Id"| SpringBoot
    NextJS -->|"BFF /api/* proxy"| SpringBoot

    %% MCP → Backend
    MCP -->|"MCP SSE /mcp/sse"| SpringBoot

    %% Клієнт → зовнішні → Backend
    Messenger --> Facebook & Gmail
    Facebook -->|"Webhook POST"| SpringBoot
    Gmail -->|"IMAP poll / SMTP"| SpringBoot

    %% Backend → інфра
    SpringBoot -->|"JDBC jdbc:postgresql"| Postgres
    SpringBoot -->|"AMQP :5672"| RabbitMQ
    SpringBoot -->|"read / write files"| LocalFS

    %% Backend → зовнішні API
    SpringBoot -->|"HTTPS Spring AI"| Gemini
    SpringBoot -->|"OAuth2 callback"| Google
    SpringBoot -->|"Graph API"| Facebook
    SpringBoot -->|"JavaMail"| Gmail

---

%% Компактна версія для слайду презентації
flowchart LR
    U((Оператор)) --> FE["Next.js<br/>:3000"]
    FE -->|"REST/WS"| BE["Spring Boot<br/>:8080"]
    BE --> DB[("PostgreSQL<br/>pgvector :5432")]
    BE --> MQ["RabbitMQ<br/>:5672"]
    BE --> FS["Local FS"]
    BE --> Gemini["Gemini API"]
    MCP((MCP)) --> BE
    Client((Клієнт)) --> FB["Facebook / Email"] --> BE
